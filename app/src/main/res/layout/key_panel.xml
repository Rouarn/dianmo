<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/key1"
            style="@style/KeyButton"
            android:text="1" />
        <TextView
            android:id="@+id/key2"
            style="@style/KeyButton"
            android:text="2" />
        <TextView
            android:id="@+id/key3"
            style="@style/KeyButton"
            android:text="3" />
        <TextView
            android:id="@+id/key4"
            style="@style/KeyButton"
            android:text="4" />
        <TextView
            android:id="@+id/key5"
            style="@style/KeyButton"
            android:text="5" />
        <TextView
            android:id="@+id/keyDel"
            style="@style/KeyButtonFunc"
            android:text="删除" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/key6"
            style="@style/KeyButton"
            android:text="6" />
        <TextView
            android:id="@+id/key7"
            style="@style/KeyButton"
            android:text="7" />
        <TextView
            android:id="@+id/key8"
            style="@style/KeyButton"
            android:text="8" />
        <TextView
            android:id="@+id/key9"
            style="@style/KeyButton"
            android:text="9" />
        <TextView
            android:id="@+id/key0"
            style="@style/KeyButton"
            android:text="0" />
        <TextView
            android:id="@+id/keySearch"
            style="@style/KeyButtonPrimary"
            android:text="搜索" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/keyDot"
            style="@style/KeyButton"
            android:text="." />
        <TextView
            android:id="@+id/keyMinus"
            style="@style/KeyButton"
            android:text="-" />
        <TextView
            android:id="@+id/keyColon"
            style="@style/KeyButton"
            android:text=":" />
        <TextView
            android:id="@+id/keyComma"
            style="@style/KeyButton"
            android:text="," />
        <TextView
            android:id="@+id/keyClear"
            style="@style/KeyButtonFunc"
            android:text="清空" />
        <TextView
            android:id="@+id/keyHide"
            style="@style/KeyButtonFunc"
            android:text="隐藏" />
    </LinearLayout>
</LinearLayout>
