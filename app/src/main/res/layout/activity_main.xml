<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.12" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/on_surface"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="内存扫描 · 单机游戏数值修改工具"
        android:textColor="@color/on_surface_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRootStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="@string/root_status_unknown"
        android:textColor="@color/warn"
        android:textSize="13sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartOverlay"
        style="@style/Widget.DianMo.Button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="启动悬浮窗"
        android:textSize="18sp"
        app:cornerRadius="18dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/root_status_unknown"
        android:textColor="@color/on_surface_secondary"
        android:textSize="12sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.22" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="启动后回到游戏，所有操作都在悬浮窗内完成\n\n1. 点悬浮球展开面板\n2. 选择进程\n3. 输入数值搜索、改写\n\n长按拖动标题栏可移动位置"
        android:textColor="@color/on_surface_secondary"
        android:textSize="12sp" />
</LinearLayout>
