<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingVertical="20dp">

    <!-- 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dlgSeal"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_seal"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="修"
            android:textColor="#FFF5EDDD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dlgTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:letterSpacing="0.1"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginTop="10dp"
        android:background="@color/ink_line_strong" />

    <TextView
        android:id="@+id/dlgMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="serif"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/ink_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/dlgInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_field"
        android:fontFamily="serif"
        android:paddingHorizontal="12dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dlgNeutral"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_inkline"
            android:fontFamily="serif"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dlgNegative"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_inkline"
            android:fontFamily="serif"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dlgPositive"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_seal"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:paddingHorizontal="20dp"
            android:textColor="#FFF7F0E2"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
